# SecureChain DMS — Environment Variables
# Copy this file to .env and fill in real values before running.
# docker compose automatically reads .env from this directory.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=securechain
POSTGRES_PASSWORD=securechain_dev_pw
POSTGRES_DB=securechain_dms

# ---------------------------------------------------------------------------
# Backend (Node.js / Express)
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_in_production_use_a_long_random_string

# ---------------------------------------------------------------------------
# AI Service (FastAPI)
# ---------------------------------------------------------------------------
# Maximum upload size in MB (default 25)
MAX_UPLOAD_MB=25

# Log level for the AI service: debug | info | warning | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# GitLab CI/CD Registry (set in GitLab CI/CD variables, not in .env)
# ---------------------------------------------------------------------------
# CI_REGISTRY=registry.gitlab.com
# CI_REGISTRY_IMAGE=registry.gitlab.com/<group>/<project>
# CI_REGISTRY_USER=<gitlab-deploy-token-username>
# CI_REGISTRY_PASSWORD=<gitlab-deploy-token-password>
